@import 'variables.css';

.user-management-container {
  padding: var(--spacing-xl);
  background: var(--soft-gray);
  min-height: 100vh;
  font-family: var(--font-secondary);
  width: 100%;
  margin: 0;
  align-items: start;
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-management-header {
  text-align: center;
  margin-bottom: var(--spacing-xxl);
  background: linear-gradient(135deg, var(--cream-overlay) 0%, rgba(255, 255, 255, 0.95) 100%);
  backdrop-filter: blur(20px);
  padding: var(--spacing-xl);
  border-radius: var(--radius-xl);
  border: 2px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 20px 40px rgba(139, 111, 78, 0.15);
  position: relative;
  overflow: hidden;
  animation: slideInFromTop 0.8s ease-out;
}

.user-management-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  animation: shimmer 3s infinite;
}

@keyframes slideInFromTop {
  from {
    opacity: 0;
    transform: translateY(-50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.user-management-header h2 {
  font-family: var(--font-primary);
  color: var(--primary-brown);
  font-size: 2.5rem;
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
  position: relative;
}

.user-management-header h2::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 3px;
  background: linear-gradient(90deg, var(--terracotta), var(--primary-brown));
  border-radius: 2px;
}

.user-management-header p {
  color: var(--dark-brown);
  font-size: 1.1rem;
  opacity: 0.8;
}

.user-management-content {
  display: grid;
  gap: var(--spacing-xxl);
}

/* Sección del formulario */
.user-form-section {
  background: var(--cream-overlay);
  backdrop-filter: blur(15px);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--medium-shadow);
  border: 2px solid rgba(255, 255, 255, 0.3);
  position: relative;
}

.user-form-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--terracotta), var(--primary-brown));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.section-header {
  text-align: center;
  margin-bottom: var(--spacing-xl);
}

.section-header h3 {
  font-family: var(--font-primary);
  color: var(--primary-brown);
  font-size: 1.8rem;
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
}

.section-header p {
  color: var(--dark-brown);
  opacity: 0.8;
}

.user-form-container {
  display: grid;
  gap: var(--spacing-lg);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-lg);
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.form-group label {
  font-weight: 600;
  color: var(--primary-brown);
  font-size: 0.9rem;
  font-family: var(--font-secondary);
}

.form-input {
  width: 100%;
  padding: var(--spacing-sm);
  border: 2px solid var(--stone-gray);
  border-radius: var(--radius-md);
  background: var(--warm-white);
  color: var(--primary-brown);
  font-size: 1rem;
  font-family: var(--font-secondary);
  transition: all 0.3s ease;
}

.form-input::placeholder {
  color: var(--light-brown);
  opacity: 0.7;
}

.form-input:focus {
  outline: none;
  border-color: var(--terracotta);
  box-shadow: 0 0 0 3px rgba(193, 123, 74, 0.1);
}

.form-input.error {
  border-color: #ef4444;
}

.password-input-wrapper {
  position: relative;
}

.password-toggle-btn {
  position: absolute;
  right: var(--spacing-sm);
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--light-brown);
  cursor: pointer;
  padding: var(--spacing-xs);
  border-radius: var(--radius-sm);
  transition: all 0.3s ease;
}

.password-toggle-btn:hover {
  color: var(--primary-brown);
  background: rgba(107, 68, 35, 0.1);
}

.error-message {
  color: #ef4444;
  font-size: 0.8rem;
  margin-top: var(--spacing-xs);
}

.submit-btn {
  justify-self: center;
  min-width: 200px;
}

.loading-spinner {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Sección de la tabla */
.user-table-section {
  background: var(--cream-overlay);
  backdrop-filter: blur(15px);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--medium-shadow);
  border: 2px solid rgba(255, 255, 255, 0.3);
  position: relative;
}

.user-table-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--sage-green), var(--terracotta));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.table-container {
  background: var(--warm-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--soft-shadow);
  border: 1px solid rgba(107, 68, 35, 0.1);
}

.table-wrapper {
  overflow-x: auto;
}

.users-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.users-table th {
  background: var(--primary-brown);
  color: var(--warm-white);
  padding: var(--spacing-md);
  text-align: left;
  font-weight: 600;
  font-family: var(--font-primary);
}

.users-table td {
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1px solid rgba(107, 68, 35, 0.1);
  color: var(--charcoal);
}

.users-table tr:hover {
  background: rgba(193, 123, 74, 0.05);
}

.user-id {
  font-weight: 600;
  color: var(--primary-brown);
}

.user-name {
  color: var(--primary-brown);
  font-weight: 500;
}

.user-email {
  color: var(--dark-brown);
  font-size: 0.85rem;
}

.fecha-registro {
  font-size: 0.85rem;
  color: var(--stone-gray);
}

/* Badges y estados */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: 4px var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  font-weight: 500;
}

.badge-success {
  background: #dcfce7;
  color: #166534;
}

.badge-warning {
  background: #fef3c7;
  color: #92400e;
}

.badge-danger,
.badge-error {
  background: #fee2e2;
  color: #991b1b;
}

.rol-badge {
  background: var(--lightbrown-overlay);
  color: var(--warm-white);
  padding: 4px var(--spacing-sm);
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  font-weight: 500;
}

/* Acciones de tabla */
.table-actions {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
}

.action-btn {
  background: none;
  border: 1px solid;
  border-radius: var(--radius-sm);
  padding: 4px var(--spacing-sm);
  font-size: 0.8rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: all 0.3s ease;
  font-family: var(--font-secondary);
}

.btn-danger {
  border-color: #ef4444;
  color: #ef4444;
}

.btn-danger:hover:not(:disabled) {
  background: #ef4444;
  color: white;
  transform: translateY(-2px);
  box-shadow: var(--soft-shadow);
}

.btn-danger:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.inactive-label {
  font-size: 0.8rem;
  color: var(--stone-gray);
  font-style: italic;
}

/* Estado vacío */
.empty-state {
  text-align: center;
  padding: var(--spacing-xxl);
  color: var(--stone-gray);
  background: var(--warm-white);
  border-radius: var(--radius-lg);
  border: 2px dashed var(--stone-gray);
}

.empty-state svg {
  color: var(--light-brown);
  margin-bottom: var(--spacing-md);
}

.empty-state p {
  color: var(--primary-brown);
  font-size: 1.1rem;
  font-weight: 500;
  margin-bottom: var(--spacing-xs);
}

.empty-state small {
  color: var(--stone-gray);
  font-size: 0.9rem;
}

/* Alertas */
.alert {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-lg);
  font-size: 0.9rem;
  font-weight: 500;
  backdrop-filter: blur(10px);
  border: 2px solid transparent;
}

.alert-success {
  background: rgba(220, 252, 231, 0.9);
  color: #166534;
  border-color: rgba(34, 197, 94, 0.3);
}

.alert-error {
  background: rgba(254, 226, 226, 0.9);
  color: #991b1b;
  border-color: rgba(239, 68, 68, 0.3);
}

.alert span {
  flex: 1;
}

/* Responsive Design */
@media (max-width: 768px) {
  .user-management-container {
    padding: var(--spacing-lg);
  }

  .user-management-header {
    padding: var(--spacing-lg);
  }

  .user-management-header h2 {
    font-size: 2rem;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  .table-wrapper {
    overflow-x: scroll;
  }

  .users-table {
    min-width: 700px;
    font-size: 0.8rem;
  }

  .users-table th,
  .users-table td {
    padding: var(--spacing-sm);
  }

  .section-header h3 {
    font-size: 1.5rem;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .rustic-button {
    width: 100%;
    justify-self: stretch;
  }
}

@media (max-width: 480px) {
  .user-management-container {
    padding: var(--spacing-md);
  }

  .user-form-section,
  .user-table-section {
    padding: var(--spacing-lg);
  }

  .user-management-header {
    padding: var(--spacing-md);
  }

  .logout-container {
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .user-name-display {
    font-size: 0.9rem;
  }

  .logout-button {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .logout-modal {
    padding: var(--spacing-xl);
    margin: var(--spacing-md);
  }

  .logout-modal-actions {
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .logout-cancel-btn,
  .logout-confirm-btn {
    width: 100%;
    justify-content: center;
  }

  .user-management-header h2 {
    font-size: 1.8rem;
  }

  .section-header h3 {
    font-size: 1.3rem;
  }

  .users-table {
    font-size: 0.75rem;
  }

  .form-input {
    font-size: 0.9rem;
  }

  .alert {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.85rem;
  }
}

/* Animaciones */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-form-section,
.user-table-section {
  animation: fadeInUp 0.6s ease;
}

.user-form-section:nth-child(1) {
  animation-delay: 0.1s;
}

.user-table-section:nth-child(2) {
  animation-delay: 0.2s;
}

/* Hover effects mejorados */
.user-form-section:hover,
.user-table-section:hover {
  transform: translateY(-2px);
  box-shadow: var(--strong-shadow);
}

/* Transiciones suaves */
.user-form-section,
.user-table-section,
.form-input,
.action-btn,
.rustic-button {
  transition: all 0.3s ease;
}

