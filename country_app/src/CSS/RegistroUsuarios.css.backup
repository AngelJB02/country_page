    padding: var(--spacing-lg);
  }

  .user-management-header {
    padding: var(--spacing-lg);
  }

  .user-management-header h2 {
    font-size: 2rem;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  .table-wrapper {
    overflow-x: scroll;
  }

  .users-table {
    min-width: 700px;
    font-size: 0.8rem;
  }

  .users-table th,
  .users-table td {
    padding: var(--spacing-sm);
  }

  .section-header h3 {
    font-size: 1.5rem;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .rustic-button {
    width: 100%;
    justify-self: stretch;
  }
}

@media (max-width: 480px) {
  .user-management-container {
    padding: var(--spacing-md);
  }

  .user-form-section,
  .user-table-section {
    padding: var(--spacing-lg);
  }

  .user-management-header {
    padding: var(--spacing-md);
  }

  .logout-container {
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .user-name-display {
    font-size: 0.9rem;
  }

  .logout-button {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .logout-modal {
    padding: var(--spacing-xl);
    margin: var(--spacing-md);
  }

  .logout-modal-actions {
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .logout-cancel-btn,
  .logout-confirm-btn {
    width: 100%;
    justify-content: center;
  }

  .user-management-header h2 {
    font-size: 1.8rem;
  }

  .section-header h3 {
    font-size: 1.3rem;
  }

  .users-table {
    font-size: 0.75rem;
  }

  .form-input {
    font-size: 0.9rem;
  }

  .alert {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.85rem;
  }

  .form-row {
    grid-template-columns: 1fr !important; /* for very small screens */
  }

  .table-wrapper {
    overflow-x: auto; /* tablas se desplazan horizontalmente */
  }

  .users-table {
    min-width: 480px; /* evita celdas demasiado estrechas */
  }

  .users-table th,
  .users-table td {
    padding: 0.4rem;
  }

  .action-btn {
    font-size: 0.7rem;
    padding: 0.3rem 0.5rem;
  }
}

.user-form-section,
.user-table-section {
  animation: fadeInUp 0.6s ease;
}

.user-form-section:nth-child(1) {
  animation-delay: 0.1s;
}

.user-table-section:nth-child(2) {
  animation-delay: 0.2s;
}

/* Hover effects mejorados */
.user-form-section:hover,
.user-table-section:hover {
  transform: translateY(-2px);
  box-shadow: var(--strong-shadow);
}

/* Transiciones suaves */
.user-form-section,
.user-table-section,
.form-input,
.action-btn,
.rustic-button {
  transition: all 0.3s ease;
}
